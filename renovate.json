{
  "$schema": "http://json.schemastore.org/renovate",
  "extends": ["config:recommended"],
  "prHourlyLimit": 5,
  "schedule": ["before 3am on Monday"],
  "packageRules": [
    {
      "groupName": "Sourcegraph Docker images",
      "versioning": "semver",
      "ignoreUnstable": false,
      "semanticCommits": "disabled",
      "automerge": true,
      "matchPackageNames": [
        "/^index.docker.io/sourcegraph//",
        "!index.docker.io/sourcegraph/grafana",
        "!index.docker.io/sourcegraph/prometheus"
      ]
    },
    {
      "matchPackageNames": [
        "index.docker.io/sourcegraph/grafana",
        "index.docker.io/sourcegraph/prometheus"
      ],
      "groupName": "Sourcegraph Prometheus / Grafana Docker images",
      "allowedVersions": "<10.0",
      "versioning": "semver",
      "ignoreUnstable": false,
      "semanticCommits": "disabled",
      "automerge": true
    }
  ],
  "dependencyDashboard": true,
  "pinDigests": true
}
